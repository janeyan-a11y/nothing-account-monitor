# Nothing Account 社媒舆情监控 — 环境变量配置
# 复制此文件为 .env 并填入真实值

# ============================================================
# Twitter/X — twikit 方案（免 API 额度，需 X 账号登录）
# ============================================================
X_EMAIL=your_x_email@example.com
X_PASSWORD=your_x_password

# ============================================================
# Twitter/X — API 方案（备用，从 developer.x.com 获取）
# ============================================================
# X_BEARER_TOKEN=your_bearer_token_here
# X_API_KEY=your_api_key_here

# ============================================================
# YouTube Data API v3
# 获取: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# ============================================================
YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================================
# 邮件告警（Gmail SMTP）
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jane.yan@nothing.tech
SMTP_PASS=your_gmail_app_password_here
ALERT_EMAIL=jane.yan@nothing.tech
ALERT_THRESHOLD=1